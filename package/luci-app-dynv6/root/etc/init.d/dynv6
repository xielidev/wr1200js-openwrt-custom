#!/bin/sh /etc/rc.common
#
# Keep the dynv6 record for this device refreshed: update once at start and
# again every five minutes, so the record does not expire.

USE_PROCD=1
START=95
STOP=10

start_service() {
	config_load dynv6
	config_get_bool enabled main enabled 0

	[ "$enabled" = "1" ] || return 0

	procd_open_instance
	procd_set_param command /bin/sh -c 'while :; do /usr/libexec/dynv6-update; sleep 300; done'
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}